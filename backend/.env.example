# Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for chat, summaries, and insights.
# Groq deprecates/rotates models periodically — if AI features stop working
# with a "model_decommissioned" or similar error, check
# https://console.groq.com/docs/models for the current recommended model
# and update this line.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in megabytes
MAX_UPLOAD_MB=500

# Best-effort correction for Arabic text extracted from PDFs (reshaping +
# RTL reordering). Set to "false" if it ever makes a specific document's
# text worse instead of better.
ARABIC_PDF_FIX=true

# Folder (relative to backend/) where uploaded files and derived data are stored
UPLOAD_FOLDER=uploads

# Flask
FLASK_ENV=development
PORT=5000
